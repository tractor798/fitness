<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/surfaceContainerLowest">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- 动作缩略图 -->
        <RelativeLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginEnd="16dp">

            <ImageView
                android:id="@+id/exerciseImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"
                android:background="@drawable/bg_exercise_thumbnail" />

            <!-- 播放按钮覆盖层 -->
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerInParent="true"
                android:src="@android:drawable/ic_media_play"
                android:tint="@android:color/white"
                android:background="@drawable/bg_play_overlay" />
        </RelativeLayout>

        <!-- 动作信息 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/exerciseNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="杠铃深蹲"
                android:textColor="@color/onSurface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/exerciseDetailsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="4 组 × 12 次 • 休息 60s"
                android:textColor="@color/onSurfaceVariant"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 拖拽指示器 -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:tint="@color/onSurfaceVariant"
            android:alpha="0.3" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
